# Copie para .env e preencha. NUNCA publique o arquivo .env.
PORT=3000
# URL pública da loja (usada nos retornos e no webhook)
SITE_URL=https://www.sualoja.com.br
# Provedor ativo: mercadopago | stripe
PAYMENT_PROVIDER=mercadopago

# Mercado Pago (Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Stripe (Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
